{
  "name": "minder",
  "productName": "Minder",
  "version": "1.0.0",
  "description": "\u0631\u062f\u06cc\u0627\u0628\u06cc \u0633\u0627\u0639\u062a \u06a9\u0627\u0631 \u0645\u062a\u0645\u0631\u06a9\u0632 \u0631\u0648\u0632\u0627\u0646\u0647",
  "author": "Ashkan Alizadeh",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.minder.tracker",
    "productName": "Minder",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Minder"
    }
  }
}
